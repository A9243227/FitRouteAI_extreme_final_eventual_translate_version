# 複製這個檔案為 key.env 後填入實際數值
# cp key.env.example key.env

# Flask session 簽章金鑰，請用隨機字串（例如 python -c "import secrets;print(secrets.token_hex(32))"）
SECRET_KEY=

# 資料庫連線字串
DATABASE_URL=sqlite:///users.db

# 後端 /api/elevation 代理使用的 Google Maps 金鑰
# 請在 Google Cloud Console 建立並加上 API / 來源限制
GOOGLE_MAPS_API_KEY=

# 選填：/segment_stream 內部呼叫 /chat_stream 的位置，預設 http://localhost:5000/chat_stream
# CHAT_STREAM_URL=
